{
  "name": "easymarkdown",
  "version": "0.5.0",
  "private": true,
  "description": "EasyMarkdown — 桌面 Markdown 编辑器",
  "author": "EasyMarkdown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ychl758/EasyMarkdown.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "electron:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:installer": "npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test": "node scripts/test-ui.mjs && node scripts/test-extra.mjs && node scripts/test-import.mjs && node scripts/test-preview-edit.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:extra": "node scripts/test-extra.mjs",
    "test:import": "node scripts/test-import.mjs",
    "test:preview": "node scripts/test-preview-edit.mjs",
    "test:electron": "node scripts/test-electron.mjs",
    "shot": "node scripts/shot-v3.mjs"
  },
  "build": {
    "appId": "com.easymarkdown.app",
    "productName": "EasyMarkdown",
    "copyright": "EasyMarkdown",
    "publish": [
      {
        "provider": "github",
        "owner": "ychl758",
        "repo": "EasyMarkdown"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.png",
      "dist/EasyMarkdown.html",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyMarkdown",
      "artifactName": "EasyMarkdown-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "EasyMarkdown-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.0",
    "dompurify": "^3.2.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.65.0"
  }
}
